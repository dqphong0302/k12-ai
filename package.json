{
  "name": "bobo-ai-k12",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "validate:content": "node scripts/validate-content.mjs",
    "test": "node --test src/**/*.test.js",
    "test:e2e": "pnpm build && playwright test --project=chromium",
    "test:e2e:mobile": "pnpm build && playwright test tests/e2e/mobile.spec.js --project=mobile",
    "test:e2e:all": "pnpm build && playwright test --project=chromium --project=mobile --project=webkit",
    "build": "pnpm validate:content && vite build && node scripts/check-performance.mjs",
    "preview": "vite preview",
    "audio:generate": "node scripts/generate-lesson-audio.mjs",
    "audio:check": "node scripts/check-audio-provenance.mjs",
    "audio:middle": "TTS_SCOPE=middle node scripts/generate-lesson-audio.mjs",
    "audio:high": "TTS_SCOPE=high node scripts/generate-lesson-audio.mjs"
  },
  "dependencies": {
    "@tensorflow-models/mobilenet": "^2.1.1",
    "@tensorflow/tfjs": "^4.22.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.5"
  },
  "packageManager": "pnpm@10.17.1"
}
